\par {\listtext\pard\plain\ltrpar \rtlch\fcs1 \af1\afs21 \ltrch\fcs0 \f2\fs21\insrsid10694274 \hich\af2\dbch\af0\loch\f2 o\tab}}\pard \ltrpar
